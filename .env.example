# =============================================================================
# DeskcommCRM — variáveis de ambiente
# =============================================================================
# Copie para .env.local e preencha. NUNCA commitar .env*.
# Variáveis NEXT_PUBLIC_* são expostas ao browser; o resto fica server-side.
# =============================================================================

# --- Supabase ----------------------------------------------------------------
# URL pública do projeto Supabase (ex: https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# anon key (safe pra browser; RLS é o gatekeeper real)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service role key — BYPASSA RLS. Apenas server. Nunca commitar. Rotação trimestral.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron / interno ----------------------------------------------------------
# Bearer secret pros endpoints /api/v1/cron/*. DIFERENTE do service role key.
INTERNAL_SECRET=

# --- Encryption keys (pgcrypto) ----------------------------------------------
# Chave separada pra criptografar CPF em contacts (PII sensível LGPD).
CPF_ENCRYPTION_KEY=
# Chave pra criptografar tokens OAuth Nuvemshop em tenant_integrations.
NUVEMSHOP_OAUTH_ENCRYPTION_KEY=
# Chave pra criptografar credenciais BYO-WAHA (cliente que roda WAHA próprio).
WAHA_BYO_ENCRYPTION_KEY=
# Chave AES-256 (32 bytes em base64) pra criptografar API keys de provedores LLM
# (ai_provider_credentials). Gerar: openssl rand -base64 32
AI_CRED_AES_KEY=

# --- WAHA --------------------------------------------------------------------
# URL base da instância WAHA (ex: http://localhost:3000 em dev; https://waha.deskcomm.com em prod)
WAHA_API_BASE_URL=http://localhost:3000
# Plaintext da API key do WAHA. O ENV do container WAHA recebe o hash SHA512 hex desta.
# Gerar: echo -n "minha-chave-aqui" | shasum -a 512
WAHA_API_KEY=
# URL pública do app que o WAHA chama em webhooks (precisa ser HTTPS público; use ngrok em dev).
WAHA_WEBHOOK_BASE_URL=

# --- Upstash Redis (rate limit, idempotency) ---------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- AI providers ------------------------------------------------------------
# Vercel AI Gateway (preferencial — fallback de provedor + observability + ZDR)
# AI_GATEWAY_API_KEY: chave do gateway. Quando ausente, ai-response-worker
# pula com skip="ai_gateway_key_missing" (não bloqueia boot do app).
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
VERCEL_AI_GATEWAY_URL=
# Fallback direto Anthropic (caso AI Gateway indisponível ou desabilitado pra um tenant)
ANTHROPIC_API_KEY=
# Pra embeddings (text-embedding-3-small) usados no RAG por tenant
OPENAI_API_KEY=

# --- Workers -----------------------------------------------------------------
# Opt-in pra rodar consumers de event_log. Default false em dev; true em prod cron.
EVENT_LOG_WORKER_ENABLED=false

# --- Sentry ------------------------------------------------------------------
SENTRY_DSN=

# --- Nuvemshop OAuth ---------------------------------------------------------
# Obtenha em https://partners.tiendanube.com/ (criar app → copiar credenciais).
# Deixe vazio em dev/staging se ainda não tiver app aprovado — a integração
# degrada graciosamente e a UI mostra "Integração não configurada".
# APP_ID aparece na URL do painel do app no portal de parceiros.
NUVEMSHOP_APP_ID=
NUVEMSHOP_CLIENT_ID=
NUVEMSHOP_CLIENT_SECRET=
# Para testar webhooks em dev exponha o app via ngrok/cloudflared (HTTPS) e
# aponte NEXT_PUBLIC_APP_URL para o túnel antes de clicar "Conectar".

# --- App URLs ----------------------------------------------------------------
# URL canônica do app (tenant). Ex: https://app.deskcomm.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# URL canônica do super-admin. Ex: https://admin.deskcomm.com
NEXT_PUBLIC_ADMIN_URL=http://localhost:3000

# ── Shopee Open Platform (integração automática de Vendas — opcional) ─────────
# Crie um app em https://open.shopee.com/ e cole aqui. Enquanto vazias, a aba
# Shopee funciona no modo manual (lançamento à mão). SHOPEE_PARTNER_KEY é segredo.
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=

# ── Envio de e-mail por SMTP ─────────────────────────────────────────────────
# Caminho de entrega real quando você não tem domínio verificado no Resend — que
# é o caso por padrão. O Resend sem domínio só entrega no dono da conta; o SMTP
# entrega para qualquer destinatário. O código prefere SMTP quando os dois estão
# configurados.
#
# Gmail: gere uma SENHA DE APP (16 caracteres) em conta Google → Segurança →
# Senhas de app. Exige verificação em duas etapas ativa. Nunca use a senha da
# conta aqui. Limite ~500 e-mails/dia.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Opcional. Sem isto, o remetente é o próprio SMTP_USER.
SMTP_FROM=

# ── Calc3D PRO — venda por Pix manual (/calc3d-pro) ──────────────────────────
# Sem elas a página continua calculando e mostrando a vitrine; só o bloco de
# pagamento avisa que a chave Pix não está configurada e some o botão de compra.
#
# Para onde vai o e-mail "fulano pagou, libere o CRM", o aviso de trial iniciado e
# a notificação de lead. Vazio → cai no endereço da diretoria (lib/email/owner.ts).
PRO_SIGNUP_NOTIFY_EMAIL=
# Segredo HMAC dos botões "Aprovar e liberar" / "Recusar" no e-mail de pedido PRO
# (aprovação em 1 clique, sem login — link vale 48h e só muda pedido pendente).
# Vazio → o e-mail traz só o link para o painel. Se preenchido: ≥32 caracteres.
# Gere com: openssl rand -base64 48
PRO_APPROVAL_TOKEN_SECRET=
# Chave Pix mostrada na página (pública por natureza — é o que o comprador copia).
# Aceita CNPJ, e-mail, telefone ou chave aleatória (EVP).
NEXT_PUBLIC_PIX_KEY=
# Nome EXATO que o app do banco do comprador mostra como recebedor. Com chave
# aleatória é a única pista de que ele está pagando a pessoa certa. Vazio esconde
# a linha na página — preferível a um nome errado, que faz o comprador desistir.
NEXT_PUBLIC_PIX_RECEIVER_NAME=
# Pix copia e cola, gerado no app do banco (Pix → Receber → Copiar código).
# Tem o valor gravado dentro: a página confere contra o preço do plano e esconde
# o código se não bater. Ao mudar o preço, regere este código E o QR.
# Com NEXT_PUBLIC_PIX_KEY preenchida, o servidor GERA o copia-e-cola e o QR com o
# preço atual (platform_settings) e este campo vira só fallback.
NEXT_PUBLIC_PIX_COPIA_E_COLA=
# Cidade gravada no BR Code gerado (campo 60). Opcional; padrão BELO HORIZONTE.
PIX_RECEIVER_CITY=

# ─────────────────────────────────────────────────────────────────────────────
# Variáveis declaradas em lib/env.ts que faltavam aqui.
#
# Todas são opcionais: o app sobe sem elas e a feature correspondente degrada de
# forma explícita (o webhook devolve 500/503, o worker pula com motivo no log).
# O que NÃO pode acontecer é o operador descobrir isso em produção — daí estarem
# listadas.
# ─────────────────────────────────────────────────────────────────────────────

# Org dona da landing pública, por slug (default: gltech3d) ou id.
LANDING_ORG_SLUG=
GLTECH_ORG_SLUG=
GLTECH_ORG_ID=

# Cron interno. Sem ela, as rotas /api/v1/cron/* usam INTERNAL_SECRET.
INTERNAL_CRON_SECRET=
# 'true' devolve trace fake em /api/internal/agents/run. Deve ser 'false' em produção.
INTERNAL_AGENT_RUN_STUB=false

# HMAC dos tokens de convite de equipe. Sem ela, cai em INTERNAL_SECRET.
INVITE_TOKEN_SECRET=

# Segredos dos webhooks. Ausentes, as rotas recusam (500/503) em vez de aceitar.
INSTAGRAM_WEBHOOK_SECRET=
PRINTER_WEBHOOK_SECRET=

# E-mail transacional (Resend). Sem a key, nenhum e-mail é enviado.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# HMAC do cookie de impersonação. Mínimo 32 caracteres; abaixo disso a rota dá 503.
IMPERSONATE_COOKIE_SECRET=

# LGPD
LGPD_SIGNING_KEY=
LGPD_EXPORT_EXPIRES_HOURS=72
LGPD_DPO_EMAIL=

# Integração Nuvemshop ('true' para habilitar).
NUVEMSHOP_ENABLED=false

# Analytics com cookie (opcionais). Sem eles o banner de consentimento nao
# carrega script de terceiro; o Vercel Analytics roda sempre, sem cookie.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# Meta / Instagram. Sem META_APP_SECRET o webhook responde 503 de proposito:
# sem ele nao da para provar que o evento veio da Meta.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
